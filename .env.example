# Only copy this template inside the authorized corporate PC user data folder.
# Path: %LOCALAPPDATA%\ServeoneDashboardDesktop\.env
# Never upload real credentials or the filled .env to cloud/source control/AI.
SMRO_USERNAME=
SMRO_PASSWORD=
SMRO_HEADLESS=true
SMRO_SHOW_POPUP=false
SERP_HEADLESS=true
PUR_INFO_REG_HEADLESS=true

